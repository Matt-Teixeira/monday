APP_NAME=
LOGGER='production'
RUN_ENV='dev'

## Local Docker PG
PGHOST=pg_db
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PG_SSLMODE=require
PG_SSL_PATH=./monday/db/pg_ssl.crt

PG_PORT=5432
## STAGING
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=
# PG_SSL_PATH=

## PROD
PG_PW=
PG_DB=prod
PG_HOST=
PG_SSL_PATH=./utils/db/BaltimoreCyberTrustRoot.crt.pem

MONDAY_API_TOKEN=


## MONDAY BOARDS
MONDAY_BOARD_MRI_PLATFORM_REPORTING=
MONDAY_BOARD_ALERT_MATRIX=
MONDAY_BOARD_ID_RTT_FEED=
MONDAY_BOARD_ID_RTT_FEED_ALL=
MONDAY_BOARD_MMB_CUST_WORKFLOW=
MONDAY_BOARD_HHM_CUST_WORKFLOW=
MONDAY_BOARD_TICKETS=
MONDAY_BOARD_AVCONN_TICKETS=


#### *** START: ACUMATICA ENV *** ####

# Production API Login
PROD_LOGIN_URI=
PROD_LOGIN_NAME=
PROD_LOGIN_PW=
PROD_LOGIN_COMPANY=

# Production Equipment API
PROD_EQUIPMENT_URI=
PROD_EQUIPMENT_ALL_URI=


#### *** END: ACUMATICA ENV *** ####

## TEAMS
TEAMS_WH_REMOTE_TECH=
TEAMS_WH_AVCON_TICKETS=

# switch to 0 to go back to using your old claude billing account
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3  (host identity is per-server — REL-07)
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u <admin user 1>
UID_2=           # REQUIRED: id -u <admin user 2>

# USER_ID drives the image tag (monday:${USER_ID}) and the build LABEL.
# Dev = your host username; the release copy gets svc via the #RELEASE: line,
# applied by build-release.sh to the DEPLOYED .env only.
USER_ID=         # REQUIRED: your host username, e.g. matt-teixeira
#RELEASE:USER_ID=svc

# CONTAINER RUN USER: do NOT set here. entrypoint.sh defaults to svc (one place
# decides the production identity); dev runs pass it on the command line:
#   RUN_USER=<you> docker compose run --rm app node index.js <job>

# (IMAGE_TAG retired 2026-08 — the image tag is now monday:${USER_ID}.)
