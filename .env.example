## TEAMS
TEAMS_WH_REMOTE_TECH=
TEAMS_WH_AVCON_TICKETS=

# switch to 0 to go back to using your old claude billing account
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3  (host identity is per-server — REL-07)
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u <admin user 1>
UID_2=           # REQUIRED: id -u <admin user 2>
RUN_USER=svc
IMAGE_TAG=       # REQUIRED: image tag compose runs on this host, e.g. staging
